rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /algeria-map-leaderboard/{entryId} {
      allow read: if true;

      allow create: if
        request.resource.data.keys().hasOnly(['name', 'score', 'mode', 'date']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 24 &&
        request.resource.data.score is int &&
        request.resource.data.score > 0 &&
        request.resource.data.score <= 50000 &&
        request.resource.data.mode in ['CLASSIC', 'TIME_ATTACK', 'REVERSE', 'TRIVIA'] &&
        request.resource.data.date is string &&
        request.resource.data.date.size() <= 40;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
